# .env.example — Silent Evidence
#
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# This file lists every environment variable the app reads, with NO secret values.
#
# Generate strong secrets with:  openssl rand -hex 32

# ── Required (the app will not start without these) ───────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/silent_evidence?charset=utf8mb4"
NEXT_PUBLIC_BASE_URL="https://your-domain.example"
# Signs session cookies so `userId` cannot be forged. MUST be >= 32 random chars.
SESSION_SECRET=""

# ── Owner recovery & scheduled jobs ───────────────────────────────────────────
# The protected owner account (see lib/owner.ts). Enables owner protection and
# break-glass recovery. Without it there is no owner, only the last-admin guard.
OWNER_EMAIL=""
# Shared secret guarding /api/cron/* (publishing, retention, newsletter).
CRON_SECRET=""

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PREMIUM_MONTHLY_PRICE_ID=""
STRIPE_PREMIUM_YEARLY_PRICE_ID=""
STRIPE_AUTHOR_MONTHLY_PRICE_ID=""
STRIPE_AUTHOR_YEARLY_PRICE_ID=""

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Optional local model (mood detection); leave unset to disable.
OLLAMA_BASE_URL=""
OLLAMA_MODEL=""
OLLAMA_GENERATION=""

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Two naming schemes exist in the codebase; set whichever your mailer uses.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# ── Media (Cloudinary) ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Realtime (Pusher) ─────────────────────────────────────────────────────────
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Web push (VAPID) ──────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL=""

# ── Discord integration (optional) ────────────────────────────────────────────
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_PREMIUM_ROLE_ID=""

# ── Optional infrastructure ───────────────────────────────────────────────────
# Redis for shared rate-limit + cache across instances. Falls back to in-process.
REDIS_URL=""
# HTTPS-only IP geolocation provider template with {ip}. See lib/geoip.ts.
GEOIP_PROVIDER_URL=""

# ── Tuning ────────────────────────────────────────────────────────────────────
AUTHOR_PROMOTION_READS=""
